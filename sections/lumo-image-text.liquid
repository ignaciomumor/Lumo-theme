<section class="sec studio">
  <div class="wrap inner">
    <div class="photo grid-tex">
      {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover">{% else %}<span class="ph-note">Imagen — por definir</span>{% endif %}
    </div>
    <div>
      {% if section.settings.eyebrow != blank %}<div class="page-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      <h2 style="font-family:var(--font-display);font-weight:800;font-size:clamp(28px,4.4vw,44px);margin:0 0 16px">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LUMO · Imagen + texto",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Imagen"},
    {"type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Cómo lo pensamos"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Objetos con los que vale la pena quedarse"},
    {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Diseñamos en 3D y producimos en nuestro taller, con materiales resistentes y buena terminación. Piezas que suman identidad a tu casa.</p>"}
  ],
  "presets": [{"name": "LUMO · Imagen + texto"}]
}
{% endschema %}
