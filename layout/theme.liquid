<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#FAF3E3">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Caveat:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap">
  <style>
    @font-face{font-family:"Bristol";src:url("{{ 'bristol.otf' | asset_url }}") format("opentype");font-weight:400 700;font-style:normal;font-display:swap}
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'lumo.css' | asset_url | stylesheet_tag }}
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {{ content_for_header }}
  <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-{{ request.page_type | handle }}">
  {% render 'lumo-logo' %}
  <div id="loadscreen" aria-hidden="true"><div class="loader"></div></div>

  <div class="topbar">
    <div class="util">
      <div class="wrap">
        <div class="winbtns" role="group" aria-label="Accesos rápidos">
          <a class="wb wb-s" href="{{ routes.search_url }}" aria-label="Buscar"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg></a>
          <a class="wb wb-p" href="/pages/contacto" aria-label="Contacto"><svg viewBox="0 0 24 24" fill="none" stroke="#161A46" stroke-width="2.4"><path d="M5 4h4l2 5-2.6 1.5a11 11 0 005.1 5.1L16 13l5 2v4a2 2 0 01-2 2A16 16 0 013 5a2 2 0 012-1z" stroke-linejoin="round"/></svg></a>
          <a class="wb wb-c" href="{{ routes.cart_url }}" aria-label="Carro"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M4 5h2l1.8 10h9.4l1.8-7H7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1.3" fill="#fff" stroke="none"/><circle cx="18" cy="20" r="1.3" fill="#fff" stroke="none"/></svg></a>
        </div>
        <span class="util-loc mono">SANTIAGO, CHILE<span id="clock">--:--</span></span>
      </div>
    </div>
    <header class="nav">
      <div class="wrap">
        <button class="pill menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel">Menú</button>
        <a class="brand" href="{{ routes.root_url }}" aria-label="LUMO inicio"><svg class="logo" viewBox="5.2 0 520.13 225" role="img"><use href="#lumo"/></svg></a>
        <a class="cartlink" href="{{ routes.cart_url }}" aria-label="Carro">Carro · {{ cart.item_count }}</a>
      </div>
      <nav class="menu-panel" id="menu-panel" aria-label="Principal" hidden>
        <a href="{{ routes.root_url }}">Inicio</a>
        <a href="{{ routes.all_products_collection_url }}">Catálogo</a>
        <a href="/pages/estudio">Estudio</a>
        <a href="/pages/contacto">Contacto</a>
      </nav>
    </header>
  </div>

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  <footer id="footer">
    <div class="wrap">
      <div class="inner">
        <div class="fcol wide">
          <h4>LUMO Estudio</h4>
          <p style="margin:0 0 16px;max-width:34ch;opacity:.9">Lámparas y objetos de diseño impresos en 3D, desde Santiago de Chile.</p>
          <h4>Suscríbete</h4>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="news">
              <input type="email" name="contact[email]" placeholder="tu@correo.cl" aria-label="Correo" required>
              <button type="submit">Unirme</button>
            </div>
            {% if form.posted_successfully? %}<p style="font-family:var(--font-mono);font-size:11px;color:var(--yellow);text-transform:uppercase;margin-top:10px">✦ ¡Gracias! Quedaste en la lista.</p>{% endif %}
          {% endform %}
        </div>
        <div class="fcol">
          <h4>Tienda</h4>
          <a href="{{ routes.all_products_collection_url }}">Catálogo</a>
          <a href="/collections/lamparas">Lámparas</a>
          <a href="/collections/relojes">Relojes</a>
          <a href="/collections/accesorios">Accesorios</a>
        </div>
        <div class="fcol">
          <h4>Contacto</h4>
          <a href="https://instagram.com/lumo.cl" target="_blank" rel="noopener">Instagram @lumo.cl</a>
          <span class="copy sel" style="display:block;padding:5px 0;opacity:.92;text-transform:none">hola@lumoestudio.cl</span>
          <a href="/pages/estudio">Sobre el estudio</a>
          <a href="/pages/contacto">Contacto</a>
        </div>
      </div>
      <div class="bigword on-cobalt"><svg class="logo" viewBox="5.2 0 520.13 225" role="img" aria-label="LUMO"><use href="#lumo"/></svg></div>
      <div class="fbar">
        <span class="copy">© {{ 'now' | date: '%Y' }} LUMO Estudio — Santiago, Chile</span>
        <span class="copy">Diseño chileno ✦ lumoestudio.cl</span>
      </div>
    </div>
  </footer>

  <script>
    (function(){var el=document.getElementById('clock');function t(){try{el.textContent=new Intl.DateTimeFormat('es-CL',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/Santiago'}).format(new Date());}catch(e){el.textContent='';}}t();setInterval(t,30000);})();
    (function(){var btn=document.querySelector('.menu-btn');var panel=document.getElementById('menu-panel');if(!btn||!panel)return;function set(o){panel.hidden=!o;btn.setAttribute('aria-expanded',o?'true':'false');}btn.addEventListener('click',function(e){e.stopPropagation();set(panel.hidden);});panel.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){set(false);});});document.addEventListener('click',function(e){if(!panel.hidden&&!panel.contains(e.target)&&!btn.contains(e.target))set(false);});})();
    (function(){var ls=document.getElementById('loadscreen');if(!ls)return;if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches){ls.remove();return;}function hide(){ls.classList.add('hide');setTimeout(function(){ls.remove();},600);}if(document.readyState==='complete')setTimeout(hide,650);else window.addEventListener('load',function(){setTimeout(hide,500);});})();
    (function(){var hero=document.querySelector('.hero');var header=document.querySelector('header.nav');if(!hero||!header){return;}header.classList.add('at-hero');if(!('IntersectionObserver' in window)){header.classList.remove('at-hero');return;}var io=new IntersectionObserver(function(es){header.classList.toggle('at-hero',es[0].isIntersecting);},{threshold:0,rootMargin:'-72px 0px 0px 0px'});io.observe(hero);})();
    (function(){
      document.querySelectorAll('.card .swatches').forEach(function(g){var f=g.querySelector('.sw');if(f)f.classList.add('active');});
      document.addEventListener('click',function(e){var b=e.target.closest('.card .sw[data-target]');if(!b)return;e.preventDefault();var t=document.getElementById(b.dataset.target);if(t&&b.dataset.img){t.src=b.dataset.img;}var g=b.parentNode;g.querySelectorAll('.sw').forEach(function(x){x.classList.remove('active');});b.classList.add('active');});
    })();
  </script>
</body>
</html>
